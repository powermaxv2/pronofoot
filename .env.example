# =============================================================================
#  PronoFoot — variables d'environnement
#  Copier ce fichier en `.env` puis compléter. Les lignes vides = désactivé.
# =============================================================================

# --- Base de données ----------------------------------------------------------
# URL PostgreSQL. En docker-compose, l'hôte est le service « db ».
DATABASE_URL=postgresql://pronofoot:pronofoot@localhost:5432/pronofoot
# Base dédiée aux tests d'intégration (son nom DOIT contenir « test »).
DATABASE_URL_TEST=postgresql://pronofoot:pronofoot@localhost:5432/pronofoot_test

# Identifiants du conteneur Postgres (docker-compose uniquement).
POSTGRES_USER=pronofoot
POSTGRES_PASSWORD=change-moi-mot-de-passe-long
POSTGRES_DB=pronofoot

# --- Application --------------------------------------------------------------
# URL publique (liens des e-mails, notifications, Open Graph). Sans slash final.
APP_URL=http://localhost:3000

# --- Authentification (Auth.js) ----------------------------------------------
# Secret de chiffrement des sessions : `openssl rand -base64 32`.
AUTH_SECRET=
# Faire confiance à l'en-tête Host (nécessaire derrière un reverse proxy).
AUTH_TRUST_HOST=true

# Lien magique par e-mail : URL SMTP. En dev, Mailpit (docker-compose.dev.yml) :
#   smtp://localhost:1025  → boîte consultable sur http://localhost:8025
# En prod, exemple : smtps://utilisateur:motdepasse@smtp.fournisseur.fr:465
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=PronoFoot <no-reply@pronofoot.local>

# Connexion Google (optionnelle) : https://console.cloud.google.com/apis/credentials
# URI de redirection autorisée : {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# E-mails promus administrateurs à leur première connexion (séparés par des virgules).
ADMIN_EMAILS=admin@pronofoot.local

# --- Données football ---------------------------------------------------------
# API-Football (api-sports.io) — fournisseur principal : calendrier, compos, face-à-face.
# Offre gratuite : 100 requêtes / jour. https://dashboard.api-football.com
API_FOOTBALL_KEY=
# Budget journalier consommé par PronoFoot (garder une marge sous le quota réel).
API_FOOTBALL_DAILY_BUDGET=90

# football-data.org — repli et fournisseur du direct. Offre gratuite : 10 requêtes / minute.
# https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=
FOOTBALL_DATA_MINUTE_BUDGET=9

# Fournisseur interrogé en premier pour les scores en direct : football-data | api-football
FOOTBALL_LIVE_PROVIDER=football-data

# Saison suivie (année de début : 2026 = 2026-27). Vide = déduite de la date.
FOOTBALL_SEASON=

# --- Notifications push (Web Push) --------------------------------------------
# Générer une paire de clés : `pnpm vapid`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pronofoot.local

# --- Divers -------------------------------------------------------------------
# Dossier des avatars envoyés par les joueurs (volume Docker en prod).
UPLOAD_DIR=./data/uploads
# Désactive le rate limiting (tests end-to-end uniquement).
RATE_LIMIT_DISABLED=false

# --- Reverse proxy HTTPS (profil « https » du docker-compose) -----------------
# Nom de domaine pointant vers la machine ; Caddy obtient le certificat automatiquement.
DOMAIN=pronofoot.example.fr
ACME_EMAIL=admin@example.fr
