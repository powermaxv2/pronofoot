{
  "name": "pronofoot",
  "version": "1.0.0",
  "private": true,
  "description": "Pronostics football entre amis — points virtuels, ligues privées, live et motion design.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && pnpm build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "vapid": "node scripts/generate-vapid.mjs",
    "assets": "tsx scripts/build-assets.mts"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@date-fns/tz": "^1.4.1",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.19.0",
    "@tanstack/react-query": "^5.90.0",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "croner": "^9.1.0",
    "date-fns": "^4.1.0",
    "gsap": "^3.13.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.0",
    "next": "15.5.26",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.6",
    "radix-ui": "^1.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/smtp-server": "^3.5.12",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.3",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.26",
    "mailparser": "^3.7.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.19.0",
    "smtp-server": "^3.14.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
